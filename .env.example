# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# Obligatoria: clave de Riot (https://developer.riotgames.com)
RIOT_API_KEY=RGAPI-pega-tu-clave-aqui

# Opcional: historial de partidas en Supabase (si las dejas vacías, solo usa memoria)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Opcionales
PORT=3000
# RATE_PER_IP=10      consultas por minuto por visitante
# RATE_GLOBAL=60      consultas por minuto en total
